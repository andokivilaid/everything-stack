{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run setup:*)",
      "Bash(npm run dev:*)",
      "Bash(npm run verify:*)",
      "Bash(npm run test:e2e:*)",
      "Bash(npm run doctor)",
      "Bash(npm run skills:*)",
      "Bash(npm run config:apply)",
      "Bash(npm run config:check)",
      "Bash(npm run typecheck)",
      "Bash(npm run lint:*)",
      "Bash(npm install:*)",
      "Bash(npx convex:*)",
      "Bash(npx clerk@latest:*)",
      "Bash(npx next:*)",
      "Bash(npx playwright:*)",
      "Bash(stripe projects:*)",
      "Bash(stripe plugin install projects)",
      "Bash(stripe config --list)",
      "Bash(node scripts/*)"
    ],
    "deny": [
      "Read(./.env*)",
      "Read(./.projects/vault/**)",
      "Read(./.clerk/**)"
    ]
  },
  "enableAllProjectMcpServers": false,
  "enabledMcpjsonServers": ["convex", "next-devtools", "playwright"]
}
