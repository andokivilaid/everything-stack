# ─────────────────────────────────────────────────────────────────────────────
# Everything Stack — environment reference
#
# You do NOT need to fill this in by hand. `npm run setup` (or the
# everything-stack agent skill) writes .env.local for you:
#   - Clerk keys from an accountless dev app (`clerk init --accountless`)
#   - Convex URL from an anonymous local backend (or your cloud deployment)
#   - Stripe Projects writes provider credentials via `stripe projects env --pull`
#
# This file documents every variable the app reads. Never commit .env.local.
# ─────────────────────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth — Clerk (written by `npx clerk@latest init`)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Database — Convex (written by `npx convex dev`)
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Shared secret between Next.js route handlers and Convex (generated by setup;
# the same value is set on the Convex deployment with `npx convex env set`)
CONVEX_SERVER_SECRET=

# Billing — stripe | polar | demo  (demo simulates checkout, no provider needed)
BILLING_MODE=demo

# Stripe (test mode). `npm run setup` reads this from a logged-in Stripe CLI.
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=

# Polar (sandbox). Created by the es-billing skill via the Polar sandbox MCP.
POLAR_ACCESS_TOKEN=
POLAR_SERVER=sandbox
POLAR_WEBHOOK_SECRET=
POLAR_PRODUCT_ID_PRO=
POLAR_PRODUCT_ID_TEAM=

# Analytics — first-party analytics always on (stored in Convex).
# PostHog: `stripe projects add posthog/analytics`
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Set on the Convex deployment (npx convex env set NAME value), not here ──
# CLERK_JWT_ISSUER_DOMAIN=https://<your-app>.clerk.accounts.dev
# CONVEX_SERVER_SECRET=<same as above>
# BILLING_MODE=demo
# ADMIN_EMAILS=you@example.com,cofounder@example.com
